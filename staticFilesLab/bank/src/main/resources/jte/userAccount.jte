@param String name
@param String balance
@param String id

<div>
    <h1>Account</h1>

    <div>
        <strong>Name:</strong>&nbsp;${name}
    </div>

    <div>
        <strong>Account Number:</strong>&nbsp;${id}
    </div>

    <div>
        <strong>Balance:</strong>&nbsp;${balance}
    </div>

    <div>
        <a href="/accounts">Back to Accounts</a>
    </div>

    <div>
        <a href="/logout">Log Out</a>
    </div>
</div>